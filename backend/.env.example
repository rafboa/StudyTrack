# Port server backend
PORT=4000

# Kunci penandatangan JWT. Ganti dengan string acak yang panjang sebelum deploy.
JWT_SECRET=studytrack-secret-key-change-this

# --- Saran urutan belajar (AI). Kosongkan untuk memakai saran berbasis aturan. ---
# Kunci API Gemini (Google AI Studio). Jangan pernah di-commit.
GEMINI_API_KEY=
# Nama model Gemini; kosong = model gratis bawaan.
GEMINI_MODEL=
# Cadangan: host kompatibel OpenAI (mis. OpenRouter atau Groq) dengan model open-source.
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=
